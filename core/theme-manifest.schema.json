{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Superior Point Theme Manifest v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "tags",
    "supportedRatios",
    "tokens",
    "assets"
  ],
  "allOf": [
    {
      "$ref": "#/$defs/safeValue"
    },
    {
      "if": {
        "required": [
          "designLanguage"
        ]
      },
      "then": {
        "properties": {
          "tokens": {
            "properties": {
              "colors": {
                "minProperties": 1
              },
              "typography": {
                "minProperties": 1
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "format": {
      "const": "superior-point-theme"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "\\S"
      }
    },
    "supportedRatios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "16:9",
          "4:3"
        ]
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "colors",
        "typography",
        "spacing"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}(?:[a-fA-F0-9]{2})?$"
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "fontFamily",
              "fallback",
              "license",
              "fontSize"
            ],
            "properties": {
              "fontFamily": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S",
                "not": {
                  "pattern": "[;{}<>\\n\\r]"
                }
              },
              "fallback": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S",
                  "not": {
                    "pattern": "[;{}<>\\n\\r]"
                  }
                }
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "fontSize": {
                "type": "number",
                "minimum": 6,
                "maximum": 240
              },
              "fontWeight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "lineHeight": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 4
              }
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 512
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/style"
          },
          "description": "Optional named declarative styles, including chart styles at components.chart; omitted groups normalize to an empty object."
        },
        "motion": {
          "type": "object",
          "required": [
            "durationMs",
            "easing"
          ],
          "properties": {
            "durationMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "easing": {
              "enum": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
              ]
            }
          }
        }
      }
    },
    "layouts": {
      "type": "array",
      "maxItems": 32,
      "description": "Optional recommendations; omission normalizes to an empty list and Skin never changes geometry.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "rules"
        ],
        "allOf": [
          {
            "$ref": "#/$defs/layoutRules"
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "cover",
              "section",
              "content",
              "data",
              "image"
            ]
          },
          "rules": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "number",
                "minimum": 1,
                "maximum": 12
              },
              "gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 512
              },
              "pageInset": {
                "type": "number",
                "minimum": 0,
                "maximum": 512
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mimeType",
          "data",
          "hash",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "mimeType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "data": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      }
    },
    "designLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "origin",
        "visual",
        "motion"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principles",
            "suitableFor",
            "avoid",
            "distinctiveFeatures"
          ],
          "properties": {
            "principles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S",
                "not": {
                  "pattern": "[<>\\u0000-\\u001f]"
                }
              }
            },
            "suitableFor": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S",
                "not": {
                  "pattern": "[<>\\u0000-\\u001f]"
                }
              }
            },
            "avoid": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S",
                "not": {
                  "pattern": "[<>\\u0000-\\u001f]"
                }
              }
            },
            "distinctiveFeatures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S",
                "not": {
                  "pattern": "[<>\\u0000-\\u001f]"
                }
              }
            }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "ref",
            "sourceRevision",
            "license",
            "attribution"
          ],
          "properties": {
            "type": {
              "enum": [
                "design-systems",
                "original",
                "derived"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S",
              "not": {
                "pattern": "[<>\\u0000-\\u001f]"
              }
            },
            "sourceRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S",
              "not": {
                "pattern": "[<>\\u0000-\\u001f]"
              }
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S",
              "not": {
                "pattern": "[<>\\u0000-\\u001f]"
              }
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S",
              "not": {
                "pattern": "[<>\\u0000-\\u001f]"
              }
            }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grid",
            "imageTreatment",
            "shape",
            "spacingUnit"
          ],
          "properties": {
            "grid": {
              "enum": [
                "modular",
                "editorial",
                "freeform",
                "radial"
              ]
            },
            "imageTreatment": {
              "enum": [
                "editorial-crop",
                "contain",
                "monochrome",
                "duotone",
                "none"
              ]
            },
            "shape": {
              "enum": [
                "square",
                "rounded",
                "organic"
              ]
            },
            "spacingUnit": {
              "type": "number",
              "minimum": 0,
              "maximum": 512
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principles",
            "timing",
            "easing",
            "enter",
            "exit",
            "transition",
            "reducedMotion",
            "unsupportedBehavior"
          ],
          "properties": {
            "principles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S",
                "not": {
                  "pattern": "[<>\\u0000-\\u001f]"
                }
              }
            },
            "timing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shortMs",
                "standardMs",
                "longMs"
              ],
              "properties": {
                "shortMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "standardMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "longMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            },
            "easing": {
              "enum": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
              ]
            },
            "enter": {
              "enum": [
                "none",
                "fade",
                "slide",
                "scale"
              ]
            },
            "exit": {
              "enum": [
                "none",
                "fade",
                "slide",
                "scale"
              ]
            },
            "transition": {
              "enum": [
                "none",
                "fade",
                "slide"
              ]
            },
            "reducedMotion": {
              "enum": [
                "none",
                "fade"
              ]
            },
            "unsupportedBehavior": {
              "enum": [
                "preserve-intent-and-report"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "safeValue": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "propertyNames": {
        "not": {
          "anyOf": [
            {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            },
            {
              "pattern": "^(?:[sS][cC][rR][iI][pP][tT]|[sS][cC][rR][iI][pP][tT][sS]|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]|[hH][tT][mM][lL]|[cC][sS][sS]|[sS][rR][cC]|[hH][rR][eE][fF]|[uU][rR][lL]|[cC][oO][dD][eE]|[oO][nN][lL][oO][aA][dD]|[oO][nN][cC][lL][iI][cC][kK])$"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/safeValue"
      },
      "items": {
        "$ref": "#/$defs/safeValue"
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 240
        },
        "fontWeight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "borderRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 512
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 512
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 512
        }
      },
      "additionalProperties": {
        "if": {
          "type": "object"
        },
        "then": {
          "$ref": "#/$defs/style"
        }
      }
    },
    "layoutRules": {
      "propertyNames": {
        "not": {
          "enum": [
            "x",
            "y",
            "w",
            "h",
            "elements",
            "slides"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/layoutRules"
      },
      "items": {
        "$ref": "#/$defs/layoutRules"
      }
    }
  },
  "additionalProperties": true,
  "description": "Unknown safe JSON fields roundtrip without interpretation; executable/external-load and prototype keys are forbidden recursively. designLanguage rejects unknown fields. Runtime validation additionally checks duplicate IDs, asset bytes/signatures/hashes, ordered motion durations and package size. New curated themes must include designLanguage."
}
